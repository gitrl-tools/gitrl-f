+				if (!WordMarks.func(was.text, now.text,
+				                out removed_spans, out added_spans))
+				{
+					continue;
+				}
+
+				mark_words(buffer, was, removed_spans, "word-removed");
+				mark_words(buffer, now, added_spans, "word-added");
+			}
+		}
+
+		removed.clear();
+		added.clear();
+	}
