+class Gitg.DiffViewFilePlan : Object
+{
+	public DiffViewFileInfo info { get; construct set; }
+
+	public bool image;
+	public bool text;
+	public bool bound;
+	public bool binary;
+	public int maxlines;
+
+	public Gee.ArrayList<Ggit.DiffHunk> hunks = new Gee.ArrayList<Ggit.DiffHunk>();
+	public Gee.ArrayList<Gee.ArrayList<Ggit.DiffLine>> lines = new Gee.ArrayList<Gee.ArrayList<Ggit.DiffLine>>();
+
+	public DiffViewFilePlan(DiffViewFileInfo info)
+	{
+		Object(info: info);
+	}
+
+	public void add_hunk(Ggit.DiffHunk hunk, Gee.ArrayList<Ggit.DiffLine> lines)
+	{
+		hunks.add(hunk);
+		this.lines.add(lines);
+	}
+}
