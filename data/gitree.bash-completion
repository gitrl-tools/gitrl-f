# bash completion for gitree and git tree
#
# git-tree is completed only if nothing completes it yet, so that a shell
# alias or function of that name keeps its own completion.

__gitree()
{
	local i

	for ((i = 1; i < cword; i++)); do
		if [[ ${words[i]} == -- ]]; then
			_filedir
			return
		fi
	done

	if [[ $cur == -* ]]; then
		COMPREPLY=($(compgen -W '-a --all -l --local -r --remotes -t --tags
			-h --help --version --no-wd --' -- "$cur"))
		return
	fi

	COMPREPLY=($(compgen -W "$(git for-each-ref \
		--format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' \
		refs/heads refs/remotes refs/tags 2>/dev/null)" -- "$cur"))
}

_gitree()
{
	local cur prev words cword
	_init_completion || return

	__gitree
}

_git_tree()
{
	__gitree
}

complete -F _gitree gitree
complete -p git-tree >/dev/null 2>&1 || complete -F _gitree git-tree
