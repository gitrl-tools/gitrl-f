<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>gitrl-f</name>
  <summary>The git history of the refs that you tick</summary>

  <description>
    <p>
      Where gitg shows the history of one branch or of all of them, gitrl-f
      shows the history of the branches, remote branches and tags that you
      tick, and draws it the way gitg draws it: the same lanes, labels and
      diff.
    </p>
    <p>
      Names with slashes fold into groups, and the box of a group ticks all
      of it. A click on a commit shows its details and its diff. A
      path keeps only the commits that change a file or a folder.
    </p>
    <p>
      Nothing is ever written to the repository. The window follows it as
      you work: a commit, a fetch or a rebase redraws it in place.
    </p>
  </description>

  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Only the ticked branches are drawn, with the details of a commit below</caption>
      <image>https://raw.githubusercontent.com/li9i/gitrl-f/master/docs/screenshots/gitrlf.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/li9i/gitrl-f</url>
  <url type="bugtracker">https://github.com/li9i/gitrl-f/issues</url>

  <developer id="io.github.li9i">
    <name>alexandros filotheou</name>
  </developer>

  <provides>
    <binary>gitrlf</binary>
  </provides>

  <categories>
    <category>Development</category>
    <category>RevisionControl</category>
  </categories>

  <keywords>
    <keyword>git</keyword>
    <keyword>history</keyword>
    <keyword>branches</keyword>
    <keyword>tags</keyword>
    <keyword>refs</keyword>
    <keyword>log</keyword>
    <keyword>graph</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.7.0" date="2026-10-07">
      <description>
        <ul>
          <li>
            A strip above the list shows the staged and the unstaged changes,
            each with its number of files. A click on a row shows its diff in
            the pane.
          </li>
          <li>
            A right click on a commit, or on the staged or unstaged row, gives
            "Open diff in difftool". A right click on the header of a file
            gives "Open diff in difftool". The tool cannot write the files.
          </li>
          <li>
            After a Messages search, the pane marks the matches in the subject
            and the body of the commit.
          </li>
          <li>
            After a Messages search, the first Ctrl+F in the pane puts the
            text, Match case and Regex of the search in the find bar of the
            diff.
          </li>
          <li>
            When a repository opens, each group of refs that has no ticked ref
            is folded.
          </li>
          <li>
            A click on Match case, Regex or Display matches only keeps the
            focus in the search field.
          </li>
          <li>
            No close button floats over the diff when it fills the window.
            Escape and the back arrow close it.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.6.0" date="2026-10-02">
      <description>
        <ul>
          <li>
            A search shows each matching row of the list in bold, not only its
            hash.
          </li>
          <li>
            The refs panel opens wide enough to show each name in full, to a
            limit of 50 characters. After you drag its edge, it keeps the
            width that you chose.
          </li>
          <li>
            The search field of the list stays in place when the count
            changes.
          </li>
          <li>
            Match case, Regex and Display matches only are push buttons, not
            check boxes.
          </li>
          <li>
            In the find bar of the diff, the Enter that searches also goes to
            the first match and opens its file.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-02">
      <description>
        <ul>
          <li>
            The name of the program changes from gittree to gitrl-f. The
            package is gitrl-f and the command is gitrlf. When you install the
            package gitrl-f, it removes the package gittree.
          </li>
          <li>
            The command git tree is removed. Use gitrlf.
          </li>
          <li>
            The PPA is ppa:li9i/gitrl-f. If you added ppa:li9i/gittree, remove
            it.
          </li>
          <li>
            The settings, the ticks and the list of repositories of gittree do
            not move to gitrl-f. Set them again.
          </li>
          <li>
            With no ref and no tick option, the ticks that you last chose in a
            repository come back.
          </li>
          <li>
            One search bar above the list, opened with Ctrl+F, searches the
            messages, the changed lines or the files. Each search waits for
            Enter. Display matches only hides the other commits. The command
            line takes -S, -G and -i, as git log does.
          </li>
          <li>
            While the pane is open, Ctrl+F finds a text in the diff, with
            Match case and Regex.
          </li>
          <li>
            A right click on a file in the diff shows the history of the file,
            through its renames. A right click on a line shows the history of
            the line or of the selected lines, or goes to the commit that last
            changed the line.
          </li>
          <li>
            The menu of a commit gives the branches and tags that have it, the
            first tag with it, and the merge that brought it into the branch
            of HEAD. The menu of a ref goes to where it splits from another
            ticked ref.
          </li>
          <li>
            When a messages search finds a commit only on a ref that is not
            ticked, Tick and show ticks that ref and selects the commit.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-01">
      <description>
        <ul>
          <li>
            The name of the program changes from gitree to gittree. The
            command is gittree, and git tree runs it too. When you install
            the package gittree, it removes the package gitree.
          </li>
          <li>
            The PPA is ppa:li9i/gittree. If you added ppa:li9i/gitree,
            remove it.
          </li>
          <li>
            The settings of gitree do not move to gittree. Set your
            preferences again.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.6" date="2026-09-30">
      <description>
        <ul>
          <li>
            A right-click on a ref in the refs panel opens a menu that copies
            the name of the ref. The name of a remote branch includes the
            remote, for example origin/master. The right-click does not
            change the ticks.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.5" date="2026-09-30">
      <description>
        <ul>
          <li>
            In bash, TAB completes gittree and git tree: the options, then the
            names of the refs, and after -- the paths. The package installs
            the completion. The AppImage has no completion.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.4" date="2026-09-29">
      <description>
        <ul>
          <li>
            The commit list shows the short hash of each commit, in a column
            to the left of the author. A search marks the part of the hash
            that matches.
          </li>
          <li>
            A right-click on a hash opens a menu that copies the full hash. A
            right-click on a ref label opens a menu that copies the name of
            the ref. The right-click does not change the selection.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.3" date="2026-09-29">
      <description>
        <ul>
          <li>
            A click on a commit shows its details and its diff. Before, only
            a double click did this. A click on the same commit hides them
            again. Each click counts, thus a double click shows the pane and
            then hides it.
          </li>
          <li>
            Enter continues to fill the window with the diff when the commit
            changes only one file. A click does not.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.2" date="2026-09-28">
      <description>
        <ul>
          <li>
            A tick or an untick on the left does not move the list. The
            commit at the top of the list stays at the top. If that commit
            goes, the next commit below it takes its position. Before, the
            list went back to the first row. A change to a history setting
            also keeps the list in position.
          </li>
          <li>
            At the first row, the list stays at the first row. Thus a tick
            of a branch with newer commits shows these commits. Before, they
            stayed above the visible rows.
          </li>
          <li>
            A reload keeps the same commit at the top of the list. Before, a
            reload kept only the distance from the top, thus each new commit
            moved the rows down.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.1" date="2026-09-27">
      <description>
        <ul>
          <li>
            A click on a commit shows the row as selected at once. Before,
            the row changed colour up to 0.4 s later, because gittree made the
            diff first.
          </li>
          <li>
            The diff of a commit with two or more files shows sooner. A file
            makes its text only when you open it. On a commit with many
            files, the first files show at once and the rest follow.
          </li>
          <li>
            A diff with a Markdown file shows about 0.2 s sooner. gittree
            keeps the syntax rules of each file type loaded, so it does not
            load them again for each diff.
          </li>
          <li>
            In the unified view, an added line can come after a removed line
            with no newline at its end. The changed words on the added line
            now have their mark. Before, the mark went to the next line.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-26">
      <description>
        <ul>
          <li>
            While the diff fills the window, a close button shows at its top
            right. A click on it brings back the refs and the list, and the
            diff stays open.
          </li>
          <li>
            A double click or Enter on a commit that changes one file fills
            the window with the diff at once.
          </li>
          <li>
            A click that closes a file, or a click on Collapse all, does not
            fill the window. In 0.2.0 it did.
          </li>
          <li>
            A file in the diff closes at once when you click it. Before, its
            text stayed on the screen for a quarter of a second.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-26">
      <description>
        <ul>
          <li>
            The refs on the left follow the order of the graph. A ref whose
            commit is higher in the history comes first, and a group takes
            the place of its highest ref.
          </li>
          <li>
            The details pane opens below the refs and the list, and it is as
            wide as the window.
          </li>
          <li>
            A click on a file, or on Expand all, fills the window with the
            diff. Escape or the back arrow brings back the refs and the list.
          </li>
          <li>
            Escape closes the details also when no widget has the focus, for
            example after the divider is dragged to the top.
          </li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-26">
      <description>
        <p>
          The first release: the history of the refs that you tick, drawn as
          gitg draws it, with groups for names with slashes and the details
          of a commit on a double click.
        </p>
      </description>
    </release>
  </releases>
</component>
